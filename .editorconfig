# https://editorconfig.org — отступы табами во всём коде проекта.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab
tab_width = 4

# Фронтенд исторически с шириной отступа 2.
[*.{js,css,html,json}]
tab_width = 2

# YAML запрещает табы в отступах (спецификация), поэтому здесь пробелы.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# В Markdown таб означает блок кода, а два пробела в конце строки — перенос.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Бинарные и вендорные файлы не трогаем.
[*.{pem,db,png,ico}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
